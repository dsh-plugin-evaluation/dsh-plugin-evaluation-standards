{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Runner Capability",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "metricTypes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "metricTypes": {
      "type": "object",
      "properties": {
        "llm_judge": { "$ref": "#/$defs/metricTypeCapability" },
        "observation": { "$ref": "#/$defs/metricTypeCapability" },
        "tool_trace": { "$ref": "#/$defs/metricTypeCapability" },
        "threshold": { "$ref": "#/$defs/metricTypeCapability" }
      },
      "required": ["llm_judge", "observation", "tool_trace", "threshold"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metricTypeCapability": {
      "type": "object",
      "required": ["supported", "canAffectPass"],
      "properties": {
        "supported": { "type": "boolean" },
        "canAffectPass": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
