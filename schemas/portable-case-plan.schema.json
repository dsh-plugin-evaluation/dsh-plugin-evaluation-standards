{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Portable Case Plan",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "setup", "run", "assertions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "setup": { "type": "array", "items": { "$ref": "#/$defs/setupAction" } },
    "run": { "$ref": "#/$defs/runAction" },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*$" },
    "setupAction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "name", "value"],
          "properties": {
            "op": { "const": "environment.set" },
            "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "value": { "type": "string", "pattern": "^[^\\u0000]*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "path", "content"],
          "properties": {
            "op": { "const": "workspace.write" },
            "path": { "$ref": "#/$defs/relativePath" },
            "content": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "workspace.read" },
            "path": { "$ref": "#/$defs/relativePath" }
          },
          "additionalProperties": false
        }
      ]
    },
    "runAction": {
      "type": "object",
      "required": ["op", "input"],
      "properties": { "op": { "const": "plugin.prompt" }, "input": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["op", "value"],
      "properties": { "op": { "enum": ["output.equals", "output.contains", "output.notContains"] }, "value": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
