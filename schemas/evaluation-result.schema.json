{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Plugin Evaluation Result",
  "type": "object",
  "required": ["status", "reasons", "checks", "actualOutput"],
  "properties": {
    "status": { "enum": ["passed", "failed"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "passed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "passed": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "actualOutput": { "type": "string" },
    "score": {
      "type": "object",
      "required": ["value", "scale", "totalWeight", "requiredPassed", "passed"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "const": "0..1" },
        "passScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "totalWeight": { "type": "number", "minimum": 0 },
        "requiredPassed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
