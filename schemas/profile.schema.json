{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Plugin Evaluation Profile",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "description", "metrics", "casesPath"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "casesPath": { "type": "string", "pattern": "^cases/.+\\.json$" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "scoring": {
      "type": "object",
      "properties": {
        "method": { "const": "weighted-average" },
        "passScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "required": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
