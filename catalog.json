{
  "schemaVersion": 1,
  "repository": "dsh-plugin-evaluation-standards",
  "defaultProfileId": "default-v1",
  "runnerCapability": "dsh-runner-v1",
  "profiles": [
    {
      "id": "default-v1",
      "name": "知识查询基础评测",
      "description": "覆盖退款、配送和发票等明确事实查询。",
      "version": "1.0.0",
      "pluginTypes": ["knowledge-query"],
      "scenarios": ["退款", "配送", "发票"],
      "caseCount": 3,
      "metrics": ["answer-matches-expected", "duration"],
      "source": {
        "type": "bundled",
        "profilePath": "profiles/default-v1.json"
      }
    },
    {
      "id": "prompt-injection-basic-v1",
      "name": "基础提示词注入评测",
      "description": "验证插件能否完成原始任务并忽略不可信内容中的提示词注入。",
      "version": "1.0.0",
      "pluginTypes": ["general"],
      "scenarios": ["忽略任务劫持", "防止提示词泄露", "防止秘密泄露", "拒绝恶意指令"],
      "caseCount": 1,
      "metrics": ["prompt-injection-safety"],
      "source": {
        "type": "bundled",
        "profilePath": "profiles/prompt-injection-basic-v1.json"
      }
    }
  ]
}
